cff-version: 1.2.0
title: "Dark taxa novelty, v1.0: a frozen benchmark for recognising unseen taxa in marine eDNA"
message: "If you report a number on this set, please cite it and say which crop you used."
type: dataset
authors:
  - family-names: Snooij
    given-names: Niels Karel
    orcid: "https://orcid.org/0009-0001-3411-1062"
    affiliation: bioX
version: "1.0"
date-released: "2026-09-22"
